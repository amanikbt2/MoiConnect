# Copy this file to .env.sandbox for local sandbox services.
# Keep all credentials in this file separate from production credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/mconnect_sandbox
GEMINI_API_KEY=
# Optional separate Cloudinary cloud for sandbox material copies. Never put
# the main MConnect Cloudinary API secret in this file.
CLOUDINARY_SANDBOX_CLOUD_NAME=
CLOUDINARY_SANDBOX_API_KEY=
CLOUDINARY_SANDBOX_API_SECRET=
